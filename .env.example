# Backend and local database
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=finanzas_db
DB_PORT=5432
DB_HOST=localhost

# Frontend API base URL. Leave empty in local development to use Vite's proxy.
VITE_API_URL=

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port exposed by the production frontend container.
APP_PORT=8080
